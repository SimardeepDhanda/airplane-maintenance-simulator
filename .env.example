# Copy to .env and adjust. All values are local-development defaults.

# PostgreSQL (used by docker-compose and the API)
POSTGRES_USER=aerofleet
POSTGRES_PASSWORD=aerofleet
POSTGRES_DB=aerofleet
POSTGRES_PORT=5432

# API
DATABASE_URL=postgresql+psycopg://aerofleet:aerofleet@localhost:5432/aerofleet
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development

# Tests: a disposable database; tests drop and recreate its schema.
TEST_DATABASE_URL=postgresql+psycopg://aerofleet:aerofleet@localhost:5432/aerofleet_test

# Web (browser-visible; baked in at build time)
NEXT_PUBLIC_API_URL=http://localhost:8000
